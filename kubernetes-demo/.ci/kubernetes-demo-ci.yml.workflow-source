# CI for kubernetes-demo/. Lives at the repo root because GitHub Actions
# only discovers workflows under `.github/workflows/` at the repository
# root -- see kubernetes-demo/README.md "CI/CD" section for why this file
# is outside the kubernetes-demo/ directory despite instruction 9.
name: kubernetes-demo CI

on:
  push:
    branches: ["kubernetes-demo"]
    paths: ["kubernetes-demo/**", ".github/workflows/kubernetes-demo-ci.yml"]
  pull_request:
    branches: ["kubernetes-demo"]
    paths: ["kubernetes-demo/**", ".github/workflows/kubernetes-demo-ci.yml"]

defaults:
  run:
    working-directory: kubernetes-demo

jobs:
  lint-and-typecheck:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install -r requirements-dev.txt
      - run: ruff check .
      - run: mypy src streamlit_app

  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install -r requirements-dev.txt
      - run: pytest tests/unit tests/integration tests/security tests/k8s -v --cov=src --cov=streamlit_app

  security:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install -r requirements-dev.txt
      - run: bandit -r src streamlit_app dags
      - run: pip-audit -r requirements.txt
      - name: gitleaks
        uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  yaml-and-helm:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install yamllint
      - run: yamllint -c .yamllint.yaml k8s airflow monitoring
      - uses: azure/setup-helm@v4
        with:
          version: "v3.15.3"
      - run: |
          helm repo add apache-airflow https://airflow.apache.org
          helm repo update
          helm lint apache-airflow/airflow -f airflow/values.yaml -f airflow/values-dev.yaml

  image-scan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build Streamlit image
        run: docker build -f streamlit_app/Dockerfile -t kubernetes-demo/streamlit:ci .
      - name: Trivy scan
        uses: aquasecurity/trivy-action@0.24.0
        with:
          image-ref: "kubernetes-demo/streamlit:ci"
          severity: "CRITICAL,HIGH"
          exit-code: "1"
