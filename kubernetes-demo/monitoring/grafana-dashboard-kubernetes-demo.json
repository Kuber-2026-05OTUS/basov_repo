{
  "title": "kubernetes-demo: Airflow / CBR pipeline",
  "uid": "kubernetes-demo-airflow",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "DAG run outcomes (5m rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(airflow_dag_run_duration_success_count{dag_id=\"cbr_rates_pipeline\"}[5m]))",
          "legendFormat": "success"
        },
        {
          "expr": "sum(rate(airflow_dag_run_duration_failed_count{dag_id=\"cbr_rates_pipeline\"}[5m]))",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 2,
      "title": "Task duration p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(airflow_task_duration_bucket[5m])) by (le, task_id))",
          "legendFormat": "{{task_id}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Scheduler heartbeat",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "airflow_scheduler_heartbeat", "legendFormat": "heartbeat" }
      ]
    },
    {
      "id": 4,
      "title": "Webserver HTTP response codes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(airflow_http_response_code[5m])) by (status_code)",
          "legendFormat": "{{status_code}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pod restarts (airflow, data-platform)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\"airflow|data-platform\"}[1h])) by (namespace, pod)",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    }
  ]
}
